#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[100], n, x, i, j, temp;
    int low, high, mid, pos = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Random array elements are:\n");
    for(i = 0; i < n; i++)
    {
        a[i] = rand() % 100;
        printf("%d ", a[i]);
    }

    /* Bubble Sort */
    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(a[j] > a[j + 1])
            {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    printf("\nSorted array is:\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nEnter number to search: ");
    scanf("%d", &x);

    /* Binary Search */
    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(a[mid] == x)
        {
            pos = mid;
            break;
        }
        else if(a[mid] < x)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if(pos != -1)
        printf("Number found at position %d", pos + 1);
    else
        printf("Number not found");

    return 0;
}
