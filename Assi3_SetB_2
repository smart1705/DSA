#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char city[100][50], name[50];
    int std[100], n = 0;
    int low, high, mid, found = 0;

    fp = fopen("sortedcities.txt", "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 0;
    }

    while(n < 100 &&
          fscanf(fp, "%49s %d", city[n], &std[n]) == 2)
    {
        n++;
    }

    fclose(fp);

    printf("Enter city name: ");
    scanf("%49s", name);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(strcmp(city[mid], name) == 0)
        {
            printf("City found\n");
            printf("City: %s\nSTD Code: %d\n",
                   city[mid], std[mid]);
            found = 1;
            break;
        }
        else if(strcmp(city[mid], name) < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if(!found)
        printf("City not in the list");

    return 0;
}
