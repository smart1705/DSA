#include <stdio.h>
#include <string.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char ch) {
    stack[++top] = ch;
}

char pop() {
    return stack[top--];
}

int matching(char open, char close) {
    if (open == '(' && close == ')')
        return 1;

    if (open == '{' && close == '}')
        return 1;

    if (open == '[' && close == ']')
        return 1;

    return 0;
}

int main() {
    char str[MAX];
    int i, valid = 1;

    printf("Enter expression: ");
    scanf("%s", str);

    for (i = 0; i < strlen(str); i++) {

        if (str[i] == '(' ||
            str[i] == '{' ||
            str[i] == '[') {

            push(str[i]);
        }

        else if (str[i] == ')' ||
                 str[i] == '}' ||
                 str[i] == ']') {

            if (top == -1) {
                valid = 0;
                break;
            }

            if (!matching(pop(), str[i])) {
                valid = 0;
                break;
            }
        }
    }

    if (top != -1)
        valid = 0;

    if (valid)
        printf("Parentheses are matching\n");
    else
        printf("Parentheses are NOT matching\n");

    return 0;
}
