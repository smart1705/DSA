
#include <stdio.h>
#define MAX 5

int Q[MAX];
int front = -1, rear = -1;

void init() {
    front = rear = -1;
}

int isEmpty() {
    return front == -1;
}

int isFull() {
    return rear == MAX - 1;
}

void add(int x) {
    if (isFull()) {
        printf("Queue is full\n");
        return;
    }

    if (front == -1)
        front = 0;

    Q[++rear] = x;
    printf("Element added\n");
}

void deleteQ() {
    if (isEmpty()) {
        printf("Queue is empty\n");
        return;
    }

    printf("Deleted: %d\n", Q[front]);

    if (front == rear)
        front = rear = -1;
    else
        front++;
}

void peek() {
    if (isEmpty())
        printf("Queue is empty\n");
    else
        printf("Front element: %d\n", Q[front]);
}

int main() {
    int ch, x;
    init();

    do {
        printf("\n1.Add 2.Delete 3.Peek");
        printf("\n4.isEmpty 5.isFull 6.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                printf("Enter element: ");
                scanf("%d", &x);
                add(x);
                break;
            case 2: deleteQ(); break;
            case 3: peek(); break;
            case 4:
                printf(isEmpty() ? "Queue is empty\n" :
                                   "Queue is not empty\n");
                break;
            case 5:
                printf(isFull() ? "Queue is full\n" :
                                  "Queue is not full\n");
                break;
            case 6: printf("Exit\n"); break;
            default: printf("Invalid choice\n");
        }
    } while (ch != 6);

    return 0;
}
